# MMseqs2 Filtering Pipeline .gitignore
# Only share essential pipeline files, exclude data and results

# ====================
# GENERATED DIRECTORIES
# ====================

# MMseqs2 databases (large binary files, regenerated from FASTA)
mmseqs_db/

# Temporary files
tmp/

# Results directory (generated by pipeline)
results/

# Log files
logs/

# ====================
# DATA FILES
# ====================

# Input FASTA files (user should provide their own)
data/*.fasta
data/*.fa
data/*.fas

# ====================
# BACKUP AND TEMP FILES
# ====================

# Editor backup files
*~
*.bak
*.backup
.*.swp
.*.swo

# Python cache
__pycache__/
*.pyc
*.pyo

# OS generated files
.DS_Store
Thumbs.db

# ====================
# KEEP THESE FILES
# ====================
# The following files SHOULD be included in the repository:

# Essential scripts
# run_complete_pipeline.sh
# run_search.sh
# reduce_chunk_to_per_target.py
# compute_threshold_and_flags.py

# Documentation
# README_PIPELINE.md
# INSTRUCTIONS.md

# Configuration
# .gitignore

# Sample/test data (small files for testing)
!data/sample*.fasta
!data/test*.fasta

# ====================
# EXCEPTIONS
# ====================

# Allow specific sample data for testing (if any)
!data/README.txt